# ============================================================================
#  MUKRA — production environment (Vercel)
# ============================================================================
#
#  Copy these into Vercel → Project → Settings → Environment Variables
#  (Production, and Preview if you want previews wired to the same services).
#  Never commit the filled-in file: `.env*` is git-ignored except the
#  `*.example` templates.
#
#  The app runs perfectly with none of these set (demo mode: mock catalogue,
#  in-memory orders, "any email + password123" sign-in, local-disk uploads).
#  Add them one group at a time — every integration switches over on its own.
# ============================================================================

# ---------------------------------------------------------------------------
#  Site URL — REQUIRED in production
# ---------------------------------------------------------------------------
# Used by metadataBase, canonical URLs, the sitemap, robots.txt and OG images.
NEXT_PUBLIC_SITE_URL="https://mukra.com"

# ---------------------------------------------------------------------------
#  Database — Supabase Postgres
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooled URI (port 6543) for the app; the direct one (5432) for
# `npx prisma db push` / migrations.
#
#   npx prisma generate
#   npx prisma db push
#   npm run db:seed          # 12 products, admin, 3 customers, 4 coupons, 5 orders
DATABASE_URL=""
DIRECT_URL=""

# ---------------------------------------------------------------------------
#  Authentication — Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# CHANGE BOTH OF THESE. Without a secret the app falls back to a demo secret,
# and without NEXTAUTH_URL magic links and callbacks point at localhost.
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
# The real domain, no trailing slash — https://mukra.com
NEXTAUTH_URL="https://mukra.com"
# Auth.js v5 aliases (set these instead if you prefer the short names)
# AUTH_SECRET=""
# AUTH_URL="https://mukra.com"

# ---------------------------------------------------------------------------
#  Uploads — Cloudinary (server-side only)
# ---------------------------------------------------------------------------
# REQUIRED on Vercel: its filesystem is read-only, so without these keys the
# console can't store images at all (local-disk mode only works self-hosted).
# Cloudinary → Settings → API Keys (or Dashboard → Product Environment
# Credentials). Server-only — never prefix them with NEXT_PUBLIC_.
#
# Folders are fixed in code (lib/media.ts): mukra/products, mukra/categories,
# mukra/banners (console) and mukra/payments, mukra/returns (customers).
# Note: Vercel caps request bodies at 4.5 MB, below the 5 MB upload limit.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
#  Payments
# ---------------------------------------------------------------------------
# Comma-separated numbers customers send wallet payments to.
# Defaults when blank: +8801707302038,+8801954447017
PAYMENT_BKASH_NUMBERS="+8801707302038,+8801954447017"
PAYMENT_NAGAD_NUMBERS="+8801707302038,+8801954447017"
PAYMENT_ROCKET_NUMBERS="+8801707302038,+8801954447017"

# SSLCommerz stays parked ("Coming soon" on checkout) until you flip BOTH of
# these: NEXT_PUBLIC_ENABLE_SSLCOMMERZ="true" AND a real store id.
# Set SSLCOMMERZ_SANDBOX="false" only when you are ready to take live cards.
NEXT_PUBLIC_ENABLE_SSLCOMMERZ="false"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"

# ---------------------------------------------------------------------------
#  Admin order receipts — Mailjet
# ---------------------------------------------------------------------------
# Configure to enable "Resend Receipt" in the admin order drawer.
# Verify the sender email in Mailjet before using it.
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""
MAILJET_SENDER_EMAIL=""

# ---------------------------------------------------------------------------
#  Storefront
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Mukra"
# USD keeps the seeded catalogue coherent; switch to BDT with the price data.
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="500"
STORE_SUPPORT_EMAIL="hello@mukra.com"

# ---------------------------------------------------------------------------
#  Scheduled jobs — Staff & Roles trash retention
# ---------------------------------------------------------------------------
# A trashed account can't sign in and waits in /admin/staff → Trash for the
# retention window (TRASH_RETENTION_DAYS in lib/rbac.ts), then this daily cron
# deletes it for good — except accounts that still hold an order or a review,
# which are kept and reported as "skipped".
#
# Vercel reads the schedule from vercel.json (`0 3 * * *`) and calls the route
# with `Authorization: Bearer $CRON_SECRET` when this variable is set. Without
# it the route refuses to run in production (401), so set it there:
#     openssl rand -base64 32
CRON_SECRET=""

# Manual equivalent of the cron (also useful after shortening the window):
#     curl -H "Authorization: Bearer $CRON_SECRET" https://<domain>/api/cron/purge-trash

# ---------------------------------------------------------------------------
#  Optional monitoring (uncomment when wired)
# ---------------------------------------------------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_ANALYTICS_ID=""

# Server-only LocationIQ key for Bangladesh rural geocoding fallback.
# Register with LocationIQ; check your plan quota (never NEXT_PUBLIC_).
LOCATIONIQ_API_KEY=""
