# ============================================================================
#  LITTLE LUXE — production environment (Vercel)
# ============================================================================
#
#  Copy these into Vercel → Project → Settings → Environment Variables
#  (Production, and Preview if you want previews wired to the same services).
#  Never commit the filled-in file: `.env*` is git-ignored except the
#  `*.example` templates.
#
#  The app runs perfectly with none of these set (demo mode: mock catalogue,
#  in-memory orders, "any email + password123" sign-in, local-disk uploads).
#  Add them one group at a time — every integration switches over on its own.
# ============================================================================

# ---------------------------------------------------------------------------
#  Site URL — REQUIRED in production
# ---------------------------------------------------------------------------
# Used by metadataBase, canonical URLs, the sitemap, robots.txt and OG images.
NEXT_PUBLIC_SITE_URL="https://littleluxe.com"

# ---------------------------------------------------------------------------
#  Database — Supabase Postgres
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooled URI (port 6543) for the app; the direct one (5432) for
# `npx prisma db push` / migrations.
#
#   npx prisma generate
#   npx prisma db push
#   npm run db:seed          # 12 products, admin, 3 customers, 4 coupons, 5 orders
DATABASE_URL=""
DIRECT_URL=""

# ---------------------------------------------------------------------------
#  Authentication — Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# CHANGE BOTH OF THESE. Without a secret the app falls back to a demo secret,
# and without NEXTAUTH_URL magic links and callbacks point at localhost.
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
# The real domain, no trailing slash — https://littleluxe.com
NEXTAUTH_URL="https://littleluxe.com"
# Auth.js v5 aliases (set these instead if you prefer the short names)
# AUTH_SECRET=""
# AUTH_URL="https://littleluxe.com"

# ---------------------------------------------------------------------------
#  Uploads — Cloudinary
# ---------------------------------------------------------------------------
# All three keys are required to leave local-disk mode.
# Cloudinary → Dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: keep uploads in a production-specific folder
# CLOUDINARY_FOLDER="little-luxe/production"

# ---------------------------------------------------------------------------
#  Payments
# ---------------------------------------------------------------------------
# Comma-separated numbers customers send wallet payments to.
# Defaults when blank: +8801707302038,+8801954447017
PAYMENT_BKASH_NUMBERS="+8801707302038,+8801954447017"
PAYMENT_NAGAD_NUMBERS="+8801707302038,+8801954447017"
PAYMENT_ROCKET_NUMBERS="+8801707302038,+8801954447017"

# SSLCommerz stays parked ("Coming soon" on checkout) until you flip BOTH of
# these: NEXT_PUBLIC_ENABLE_SSLCOMMERZ="true" AND a real store id.
# Set SSLCOMMERZ_SANDBOX="false" only when you are ready to take live cards.
NEXT_PUBLIC_ENABLE_SSLCOMMERZ="false"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"

# ---------------------------------------------------------------------------
#  Storefront
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Little Luxe"
# USD keeps the seeded catalogue coherent; switch to BDT with the price data.
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="500"
STORE_SUPPORT_EMAIL="hello@littleluxe.com"

# ---------------------------------------------------------------------------
#  Optional monitoring (uncomment when wired)
# ---------------------------------------------------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_ANALYTICS_ID=""
