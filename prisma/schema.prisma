// LITTLE LUXE — Postgres schema (Supabase-compatible).
//
// The app runs without a database: every query in `lib/data/*` is wrapped in a
// try/catch and falls back to the mock dataset. Add DATABASE_URL, then run
//
//   npx prisma generate
//   npx prisma db push
//   npm run db:seed
//
// to switch the storefront onto live data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase users can point pooled connections at DATABASE_URL and set
  // DIRECT_URL for migrations, then uncomment the line below:
  // directUrl = env("DIRECT_URL")
}

/* -------------------------------------------------------------------------- */
/*  Enums                                                                     */
/* -------------------------------------------------------------------------- */

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
  CARD
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

/* -------------------------------------------------------------------------- */
/*  Models                                                                    */
/* -------------------------------------------------------------------------- */

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(CUSTOMER)
  avatar    String?
  addresses Address[]
  orders    Order[]
  returnRequests ReturnRequest[]
  wishlist  WishlistItem[]
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Product {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  sku               String?        @unique
  description       String
  price             Float
  costPrice         Float          @default(0)
  originalPrice     Float?
  category          String
  categories        String[]       @default([])
  gender            String
  ageRange          String
  material          String?
  colors            String[] // colour names
  sizes             String[]
  images            String[] // Cloudinary URLs
  modelColor        String?        // Legacy column retained for existing database compatibility.
  stock             Int            @default(0)
  variants          ProductVariant[]
  lowStockThreshold Int            @default(10)
  badge             String? // New | Sale | Bestseller | Organic
  featured          Boolean        @default(false)
  featuredOrder     Int            @default(0)
  virtualBoutique   Boolean        @default(false)
  newArrival        Boolean        @default(false)
  bestSeller        Boolean        @default(false)
  trackInventory    Boolean        @default(true)
  modelUrl          String?        // Legacy column retained for existing database compatibility.
  metaTitle         String?
  metaDescription   String?
  active            Boolean        @default(true)
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([category])
  @@index([featured, featuredOrder, active])
  @@index([virtualBoutique, active])
  @@index([newArrival, active])
  @@index([bestSeller, active])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  stock     Int     @default(0)
  sku       String?

  @@unique([productId, size, color])
  @@index([productId])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique // LL-2025-XXXXX
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  items             OrderItem[]
  returnRequests    ReturnRequest[]
  subtotal          Float
  shipping          Float         @default(0)
  discount          Float         @default(0)
  giftWrap          Float         @default(0)
  total             Float
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(UNPAID)
  paymentRef        String? // transaction ID or screenshot URL
  shippingName      String
  shippingEmail     String
  shippingPhone     String
  shippingAddress   String
  shippingCity      String
  shippingZip       String
  shippingCountry   String        @default("Bangladesh")
  notes             String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status, paymentStatus])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  color     String
  size      String
  quantity  Int
  price     Float
  returnRequests ReturnRequest[]

  @@index([orderId])
}

model ReturnRequest {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId    String
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  type           ReturnType
  reason         String
  details        String?
  requestedSize  String?
  requestedColor String?
  images         String[]
  status         ReturnStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderId])
  @@index([userId, status])
  @@index([status, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  address1  String
  address2  String?
  city      String
  state     String?
  zip       String
  country   String   @default("Bangladesh")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Float
  minOrder    Float      @default(0)
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int        @default(0)
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

/// Console-managed category metadata.
///
/// `Product.category` / `Product.categories` stay denormalised strings (the
/// storefront filters on the fixed names in `lib/validations.ts`), so this table
/// holds the presentation layer only: the emoji, the blurb and the parent.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  emoji       String   @default("🧸")
  description String   @default("")
  /// Parent category name, or null for a top-level category.
  parent      String?
  /// Lower values are listed first in the console.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parent])
  @@index([sortOrder, name])
}

model SiteSettings {
  id                String  @id @default("global")
  heroTitle         String?
  heroSubtitle      String?
  heroBadgeText     String?
  heroMediaUrl      String?
  heroMediaType     String  @default("video")
  primaryCtaText    String?
  primaryCtaLink    String?
  secondaryCtaText  String?
  secondaryCtaLink  String?
}
