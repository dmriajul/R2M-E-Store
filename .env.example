# ============================================================================
#  LITTLE LUXE — environment variables
# ============================================================================
#
#  Every value here is OPTIONAL. With no `.env` file at all the storefront runs
#  in demo mode: mock catalogue, in-memory orders, "any email + password123"
#  sign-in and local image uploads. Add the keys below and each integration
#  switches over on its own.
#
#  Copy this file to `.env`, then restart the dev server.
#     cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
#  Database — Supabase Postgres (or any Postgres)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the *pooled* connection string for the app and the direct one for
# migrations (`npx prisma db push`).
#
# After adding it, create the tables and load the demo data:
#     npx prisma generate
#     npx prisma db push
#     npm run db:seed
DATABASE_URL=""
# DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
#  Authentication — Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
# Without it, a demo secret is used (fine locally, never in production).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 also accepts the shorter names:
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
#  Image + 3D-model uploads — Cloudinary
# ---------------------------------------------------------------------------
# All three keys are required; otherwise uploads are written to .uploads/
# (git-ignored) and served through the /uploads/… route.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
#  Payments
# ---------------------------------------------------------------------------
# Mobile-wallet numbers the customer sends money to. Comma-separate several
# numbers per wallet. Defaults (used when blank): +8801707302038,+8801954447017
PAYMENT_BKASH_NUMBERS=""
PAYMENT_NAGAD_NUMBERS=""
PAYMENT_ROCKET_NUMBERS=""

# SSLCommerz is intentionally parked: the method card shows "Coming soon" until
# NEXT_PUBLIC_ENABLE_SSLCOMMERZ is "true" AND a store id exists.
NEXT_PUBLIC_ENABLE_SSLCOMMERZ="false"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"

# ---------------------------------------------------------------------------
#  Storefront
# ---------------------------------------------------------------------------
# Canonical origin used by metadata, canonicals, sitemap, robots and OG images.
# Defaults to https://littleluxe.com — override on preview deployments.
NEXT_PUBLIC_SITE_URL="https://littleluxe.com"
NEXT_PUBLIC_STORE_NAME="Little Luxe"
# USD | EUR | GBP | BDT — the demo catalogue is priced in USD.
NEXT_PUBLIC_CURRENCY="USD"
# Taka pricing is what the client brief describes (500); the seeded demo uses
# the dollar figure the storefront already displays.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="50"
STORE_SUPPORT_EMAIL="hello@littleluxe.com"
