# ============================================================================
#  MUKRA — environment variables
# ============================================================================
#
#  DATABASE_URL, an Auth.js secret and both Turnstile keys are REQUIRED.
#  The store is database-driven end to end: with no database configured the
#  catalogue routes show a maintenance state and auth returns a real error —
#  there is no demo mode and no sample catalogue.
#  Copy this template to .env.local and restart; never commit populated secrets.
# ============================================================================

# ---------------------------------------------------------------------------
#  Database — Supabase Postgres (or any Postgres)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the *pooled* connection string for the app. For schema pushes, set
# DIRECT_URL and uncomment directUrl in prisma/schema.prisma, or use a direct
# DATABASE_URL for that CLI invocation. Prisma CLI loads .env.local via
# prisma.config.ts; Next.js loads it automatically. Restart after editing.
#
# Apply reviewed schema changes to authorized staging/production, then:
#     npx prisma generate
# Do not blindly db-push or seed a live database. See docs/AUTH_PRODUCTION_FIXES.md.
#
# Bootstrap the first operator account (creates a SUPER_ADMIN, nothing else):
#     ADMIN_NAME="Your Name" ADMIN_EMAIL="you@example.com" \
#     ADMIN_PASSWORD="a-long-random-password" npm run db:seed
DATABASE_URL=""
# DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
#  Authentication — Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
# Without it, a demo secret is used (fine locally, never in production).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 also accepts the shorter names:
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
#  Image uploads — Cloudinary (server-side only)
# ---------------------------------------------------------------------------
# Where to find them: cloudinary.com → sign in → Settings (gear) → API Keys,
# or the Dashboard's "Product Environment Credentials" card.
# All three are required; without them uploads are written to .uploads/
# (git-ignored) and served through the /uploads/… route (local-disk mode).
#
# Console uploads (POST /api/admin/upload) land in:
#   mukra/products/   mukra/categories/   mukra/banners/
# JPG, PNG, WebP or AVIF · max 5 MB · stored at most 1920px wide.
# The secret never reaches the browser — never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
#  Payments
# ---------------------------------------------------------------------------
# Mobile-wallet numbers the customer sends money to. Comma-separate several
# numbers per wallet. Defaults (used when blank): +8801707302038,+8801954447017
PAYMENT_BKASH_NUMBERS=""
PAYMENT_NAGAD_NUMBERS=""
PAYMENT_ROCKET_NUMBERS=""

# SSLCommerz is intentionally parked: the method card shows "Coming soon" until
# NEXT_PUBLIC_ENABLE_SSLCOMMERZ is "true" AND a store id exists.
NEXT_PUBLIC_ENABLE_SSLCOMMERZ="false"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"

# ---------------------------------------------------------------------------
#  Admin order receipts — Mailjet
# ---------------------------------------------------------------------------
# Required for "Resend Receipt" in the admin order drawer.
# Verify the sender address in Mailjet before setting MAILJET_SENDER_EMAIL.
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""
MAILJET_SENDER_EMAIL=""

# ---------------------------------------------------------------------------
#  Storefront
# ---------------------------------------------------------------------------
# Canonical origin used by metadata, canonicals, sitemap, robots and OG images.
# Defaults to https://mukra.com — override on preview deployments.
NEXT_PUBLIC_SITE_URL="https://mukra.com"
NEXT_PUBLIC_STORE_NAME="Mukra"
# USD | EUR | GBP | BDT — prices are stored per product in the database.
NEXT_PUBLIC_CURRENCY="BDT"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="5000"
STORE_SUPPORT_EMAIL="hello@mukra.com"

# ---------------------------------------------------------------------------
#  Scheduled jobs — Staff & Roles trash retention
# ---------------------------------------------------------------------------
# A trashed account can't sign in and waits in /admin/staff → Trash for the
# retention window (TRASH_RETENTION_DAYS in lib/rbac.ts), then this daily cron
# deletes it for good — except accounts that still hold an order or a review,
# which are kept and reported as "skipped".
#
# Vercel reads the schedule from vercel.json (`0 3 * * *`) and calls the route
# with `Authorization: Bearer $CRON_SECRET` when this variable is set. Without
# it the route refuses to run in production (401), so set it there:
#     openssl rand -base64 32
CRON_SECRET=""

# Manual equivalent of the cron (also useful after shortening the window):
#     curl -H "Authorization: Bearer $CRON_SECRET" https://<domain>/api/cron/purge-trash

# Mapbox (public, safe to expose to the browser)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# ---------------------------------------------------------------------------
#  First admin account (prisma/seed.ts)
# ---------------------------------------------------------------------------
# `npm run db:seed` creates exactly one SUPER_ADMIN from these variables so you
# can sign in and add the real products. There are no default credentials.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Verification email links use NEXTAUTH_URL (or AUTH_URL). Set the real HTTPS origin.
# Local only: print verification links to the SERVER console when Mailjet is absent.
# Never enable on a shared development deployment; always ignored in production.
DEBUG_VERIFICATION_EMAILS="false"

# Cloudflare Turnstile — required in every environment, including next dev.
# Use the public Site Key here, never the secret. Public keys are bundled at build time.
# For local testing only, Cloudflare's always-pass site key is 1x00000000000000000000AA
# and its paired secret is 1x0000000000000000000000000000000AA. Never deploy test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAFR9W3cd66AOTr2B"
# Server-only secret: NEVER use a NEXT_PUBLIC_ prefix.
TURNSTILE_SECRET_KEY=""
# Comma-separated exact hostnames (preferred) or HTTP(S) origins; no paths/wildcards.
# Also accepts TURNSTILE_HOSTNAMES. Do not include localhost/127.0.0.1 in production.
# If blank, trusted AUTH_URL/NEXTAUTH_URL/NEXT_PUBLIC_SITE_URL and Vercel deployment
# hostnames are derived automatically.
TURNSTILE_ALLOWED_HOSTNAMES=""
# ---------------------------------------------------------------------------
#  Location geocoding (Bangladesh)
# ---------------------------------------------------------------------------
# Server-only LocationIQ key for Bangladesh rural geocoding fallback.
# Register with LocationIQ; check your plan quota (never NEXT_PUBLIC_).
LOCATIONIQ_API_KEY=""

# Optional local-only test shopper (never seed on production).
# Both required if either is set. Password follows /register strength rules.
# Existing accounts keep their password; seed fails if the supplied password differs.
SEED_TEST_CUSTOMER_NAME="Test Customer"
SEED_TEST_CUSTOMER_EMAIL=""
SEED_TEST_CUSTOMER_PASSWORD=""
# Account summary: npm run auth:accounts
# Passwords masked by default; local opt-in: npm run auth:accounts -- --show-passwords
